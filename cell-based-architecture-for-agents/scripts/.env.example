# Copy to scripts/.env and fill in. 
#
# Used by scripts/create-secrets.sh to create all Kubernetes secrets

# ── Shared IdP ────────────────────────────────────────────────────────────────
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
JWT_ISSUER=https://api.asgardeo.io/t/<your-org>/oauth2/token
JWKS_URI=https://api.asgardeo.io/t/<your-org>/oauth2/jwks
JWKS_HOST=api.asgardeo.io

# ── customer-service-assistant-agent-cell ─────────────────────────────────────
#Ingress
TLS_CERT_PATH=<path-to-tls-cert>
TLS_KEY_PATH=<path-to-tls-key>
CSA_JWT_AUDIENCE=<csa-jwt-audience>
CORS_ALLOW_ORIGIN=http://localhost:3000

# Auth Service
CSA_CLIENT_ID=<csa-client-id>
CSA_AGENT_ID=<csa-agent-id>
CSA_AGENT_SECRET=<csa-agent-secret>
REDIRECT_URI=https://localhost:30443/oauth/callback


# ── billing-investigation-agent-cell ──────────────────────────────────────
# Inter-cell
BIL_JWT_AUDIENCE=<bil-jwt-audience>

# Auth Service
BIL_CLIENT_ID=<bil-client-id>
BIL_AGENT_ID=<bil-agent-id>
BIL_AGENT_SECRET=<bil-agent-secret>

# ── tools-cell ────────────────────────────────────────────────────────────────
# Ingress
TOOLS_JWT_AUDIENCE=<tools-jwt-audience>

# ── LLM provider API keys ─────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
