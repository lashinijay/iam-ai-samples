# Copy to frontend/.env and fill in.
#
# Used by Vite at build/dev time. All variables must be prefixed with VITE_
# to be exposed to client-side code.

# Chat backend (customer-service-assistant-agent-cell ingress-gw).
# Use https://localhost:30443/chat for a local NodePort cluster.
VITE_CHAT_ENDPOINT_URL=https://localhost:30443/chat

# Asgardeo (or other OIDC IdP) — must match the SPA client you registered
# for the chat UI in Step 5.
VITE_REACT_APP_CLIENT_ID=<frontend-spa-client-id>
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
